import numpy as np
import matplotlib.pyplot as plt

sig = lambda x: 1 / (1 + np.exp(-x))
dsig = lambda x: x * (1 - x)

X = np.array([[0,0], [0,1], [1,0], [1,1]])
y = np.array([[0], [1], [1], [0]])

np.random.seed(42)
w1 = np.random.uniform(size=(2, 4))
w2 = np.random.uniform(size=(4, 1))
losses = []

for _ in range(4000):
    hidden = sig(X @ w1)
    output = sig(hidden @ w2)
    
    error = y - output
    losses.append(np.mean(error**2))
    
    d_out = error * dsig(output)
    d_hid = (d_out @ w2.T) * dsig(hidden)
    
    w2 += hidden.T @ d_out * 0.1
    w1 += X.T @ d_hid * 0.1

print("=== BACKPROPAGATION ANN ===")
print("Target Output:\n", y.T)
print("Predicted Output:\n", np.round(output.T, 3))

plt.figure(figsize=(7, 4))
plt.plot(losses, color='crimson', linewidth=2)
plt.title("ANN Loss Convergence Curve", fontweight='bold')
plt.xlabel("Epochs")
plt.ylabel("Mean Squared Error (MSE)")
plt.grid(True, linestyle='--', alpha=0.6)
plt.tight_layout()
plt.show()
