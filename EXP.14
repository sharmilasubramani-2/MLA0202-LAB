import pandas as pd
import matplotlib.pyplot as plt
from sklearn.linear_model import LinearRegression
from sklearn.metrics import mean_squared_error, r2_score

data = {
    'SquareFeet': [800, 1000, 1200, 1500, 1800, 2200, 2500],
    'Price_Lakhs': [40.0, 52.5, 63.0, 78.5, 94.0, 115.0, 130.0]
}

df = pd.DataFrame(data)
X = df[['SquareFeet']]
y = df['Price_Lakhs']

model = LinearRegression()
model.fit(X, y)

y_pred = model.predict(X)

print("=== HOUSE PRICE PREDICTION RESULT ===")
print("Mean Squared Error:", round(mean_squared_error(y, y_pred), 4))
print("R2 Score:", round(r2_score(y, y_pred), 4))

sample_2000 = pd.DataFrame({'SquareFeet': [2000]})
pred_lakhs = model.predict(sample_2000)[0]

pred_rupees = int(pred_lakhs * 100000)
formatted_rupees = f"{pred_rupees:,}"

pred_crores = pred_lakhs / 100

print(f"Predicted House Price for 2000 SqFt: ₹{pred_lakhs:.2f} Lakhs (₹{pred_crores:.2f} Crores)")
print(f"In Exact Rupees: ₹{formatted_rupees}")
print("SHARMILA S (192525011)\n")

plt.figure(figsize=(8, 5))
plt.scatter(df['SquareFeet'], df['Price_Lakhs'], color='darkgreen', label='Actual Property Prices', s=80)
plt.plot(df['SquareFeet'], y_pred, color='darkorange', linestyle='-', linewidth=2, label='Linear Regression Fit')

plt.title('House Price Prediction vs Area (SqFt)', fontsize=12, fontweight='bold')
plt.xlabel('Area (Square Feet)')
plt.ylabel('Price (₹ in Lakhs)')
plt.grid(True, linestyle='--', alpha=0.6)
plt.legend()
plt.tight_layout()
plt.show()
