import numpy as np
import matplotlib.pyplot as plt
from sklearn.linear_model import LogisticRegression
from sklearn.datasets import make_classification

X, y = make_classification(n_samples=100, n_features=1, n_informative=1, n_redundant=0, n_clusters_per_class=1, random_state=42)

model = LogisticRegression().fit(X, y)

print("=== LOGISTIC REGRESSION ===")
print(f"Weight Coefficient (w): {model.coef_[0][0]:.4f}")
print(f"Intercept Bias (b): {model.intercept_[0]:.4f}")

X_test = np.linspace(-3, 3, 300).reshape(-1, 1)
probs = model.predict_proba(X_test)[:, 1]

plt.figure(figsize=(7, 4))
plt.scatter(X, y, c=y, cmap='bwr', edgecolor='k', label='Data Points')
plt.plot(X_test, probs, color='black', linewidth=2, label='Logistic Curve')
plt.title("Logistic Regression Classification Curve", fontweight='bold')
plt.xlabel("Feature Value")
plt.ylabel("Probability of Class 1")
plt.legend()
plt.grid(True, linestyle='--', alpha=0.6)
plt.tight_layout()
plt.show()
