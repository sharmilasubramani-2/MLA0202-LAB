import numpy as np
import matplotlib.pyplot as plt
from sklearn.mixture import GaussianMixture

np.random.seed(42)
cluster1 = np.random.normal(loc=-2, scale=0.8, size=(100, 1))
cluster2 = np.random.normal(loc=3, scale=1.2, size=(100, 1))
X = np.vstack((cluster1, cluster2))

gmm = GaussianMixture(n_components=2, random_state=42).fit(X)

print("Estimated Means:\n", gmm.means_)
print("Estimated Covariances:\n", gmm.covariances_)

plt.figure(figsize=(7, 4))
plt.hist(X, bins=30, density=True, alpha=0.4, color='gray')

x_axis = np.linspace(-5, 7, 200).reshape(-1, 1)
pdf = np.exp(gmm.score_samples(x_axis))

plt.plot(x_axis, pdf, color='purple', linewidth=2, label='EM GMM Density')
plt.title("Expectation-Maximization Density Fit")
plt.xlabel("X")
plt.ylabel("Density")
plt.legend()
plt.grid(True)
plt.tight_layout()
plt.show()
