import pandas as pd
import matplotlib.pyplot as plt
from sklearn.linear_model import LinearRegression
from sklearn.metrics import mean_squared_error, r2_score

data = {
    'Ad_Spend_Lakhs': [2.5, 4.0, 6.2, 8.5, 10.0, 12.5, 15.0],
    'Sales_Units': [250, 380, 560, 740, 890, 1100, 1320]
}

df = pd.DataFrame(data)
X = df[['Ad_Spend_Lakhs']]
y = df['Sales_Units']

model = LinearRegression()
model.fit(X, y)

y_pred = model.predict(X)

print("=== FUTURE SALES PREDICTION RESULT ===")
print("Mean Squared Error:", round(mean_squared_error(y, y_pred), 4))
print("R2 Score:", round(r2_score(y, y_pred), 4))

sample_ad = pd.DataFrame({'Ad_Spend_Lakhs': [11.0]})
pred_sales = model.predict(sample_ad)[0]

print(f"Predicted Sales for Ad Spend ₹11.0 Lakhs: {round(pred_sales)} Units")
print("SHARMILA S (192525011)\n")

plt.figure(figsize=(8, 5))
plt.scatter(df['Ad_Spend_Lakhs'], df['Sales_Units'], color='navy', label='Actual Sales Figures', s=80)
plt.plot(df['Ad_Spend_Lakhs'], y_pred, color='darkorange', linestyle='-', linewidth=2, label='Sales Regression Trendline')

plt.title('Future Sales Prediction vs Marketing Spend', fontsize=12, fontweight='bold')
plt.xlabel('Ad Spend (₹ in Lakhs)')
plt.ylabel('Sales Volume (Units)')
plt.grid(True, linestyle='--', alpha=0.6)
plt.legend()
plt.tight_layout()
plt.show()
