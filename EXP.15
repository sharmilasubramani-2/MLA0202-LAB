import pandas as pd
import matplotlib.pyplot as plt
from sklearn.datasets import load_iris
from sklearn.model_selection import train_test_split
from sklearn.naive_bayes import GaussianNB
from sklearn.metrics import accuracy_score, classification_report

iris = load_iris()
X = pd.DataFrame(iris.data, columns=iris.feature_names)
y = iris.target

X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.3, random_state=42)

model = GaussianNB()
model.fit(X_train, y_train)

y_pred = model.predict(X_test)

print("=== IRIS CLASSIFICATION USING NAIVE BAYES RESULT ===")
print("Accuracy Score:", round(accuracy_score(y_test, y_pred), 4))
print("\nClassification Report:\n", classification_report(y_test, y_pred, target_names=iris.target_names))

sample_df = pd.DataFrame([[6.0, 3.0, 4.8, 1.8]], columns=iris.feature_names)
sample_pred = model.predict(sample_df)
print(f"Predicted Species for sample [6.0, 3.0, 4.8, 1.8]: {iris.target_names[sample_pred[0]]}")
print("SHARMILA S (192525011)\n")

plt.figure(figsize=(8, 5))
colors = ['crimson', 'forestgreen', 'royalblue']
for i, target_name in enumerate(iris.target_names):
    plt.scatter(X.iloc[y == i, 2], X.iloc[y == i, 3], c=colors[i], label=target_name, s=70)

plt.title('Iris Flower Classification (Naive Bayes)', fontsize=12, fontweight='bold')
plt.xlabel('Petal Length (cm)')
plt.ylabel('Petal Width (cm)')
plt.grid(True, linestyle='--', alpha=0.6)
plt.legend()
plt.tight_layout()
plt.show()
