import numpy as np
import matplotlib.pyplot as plt
from sklearn.datasets import make_blobs
from sklearn.neighbors import KNeighborsClassifier

X, y = make_blobs(n_samples=120, centers=2, random_state=42, cluster_std=1.5)

knn = KNeighborsClassifier(n_neighbors=3).fit(X, y)

print("=== K-NEAREST NEIGHBOURS ===")
print(f"Number of Neighbors (K): 3")
print(f"Classification Accuracy: {knn.score(X, y)*100:.2f}%")

xx, yy = np.meshgrid(np.linspace(X[:,0].min()-1, X[:,0].max()+1, 200),
                     np.linspace(X[:,1].min()-1, X[:,1].max()+1, 200))
Z = knn.predict(np.c_[xx.ravel(), yy.ravel()]).reshape(xx.shape)

plt.figure(figsize=(7, 5))
plt.contourf(xx, yy, Z, alpha=0.3, cmap='coolwarm')

scatter = plt.scatter(X[:,0], X[:,1], c=y, cmap='coolwarm', edgecolors='k')


handles, _ = scatter.legend_elements()
plt.legend(handles, ['Class 0 (Blue)', 'Class 1 (Red)'], loc='upper right')

plt.title("K-NN Decision Boundary (K=3)", fontweight='bold')
plt.xlabel("Feature 1")
plt.ylabel("Feature 2")
plt.tight_layout()
plt.show()
