# Sharmila S
# Credit Score Classification

import pandas as pd
import matplotlib.pyplot as plt
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler
from sklearn.ensemble import RandomForestClassifier

data = {
    'Income': [50000, 20000, 80000, 15000, 60000, 30000, 90000, 25000],
    'Credit_Score': [750, 600, 800, 550, 710, 630, 820, 580],
    'Target': ['Good', 'Poor', 'Good', 'Poor', 'Good', 'Poor', 'Good', 'Poor']
}

df = pd.DataFrame(data)
X = df[['Income', 'Credit_Score']]
y = df['Target']

X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.25, random_state=42)

scaler = StandardScaler()
X_train_scaled = scaler.fit_transform(X_train)
X_test_scaled = scaler.transform(X_test)

model = RandomForestClassifier(n_estimators=100, random_state=42)
model.fit(X_train_scaled, y_train)

# Visualization
good_pts = df[df['Target'] == 'Good']
poor_pts = df[df['Target'] == 'Poor']

plt.figure(figsize=(7, 5))
plt.scatter(good_pts['Income'], good_pts['Credit_Score'], color='green', label='Good Credit', s=80)
plt.scatter(poor_pts['Income'], poor_pts['Credit_Score'], color='red', label='Poor Credit', s=80)
plt.title('Credit Score vs Income Classification', fontsize=12, fontweight='bold')
plt.xlabel('Income ($)')
plt.ylabel('Credit Score')
plt.grid(True, linestyle='--', alpha=0.6)
plt.legend()
plt.tight_layout()
plt.show()

print("Predicted Credit Score:", model.predict(scaler.transform([[45000, 710]]))[0])
print("SHARMILA S (192525011)")
