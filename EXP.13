import pandas as pd
import matplotlib.pyplot as plt
from sklearn.linear_model import LinearRegression
from sklearn.metrics import mean_squared_error, r2_score

data = {
    'Year': [2020, 2021, 2022, 2023, 2024, 2025, 2026],
    'Price_Lakhs': [6.50, 7.20, 8.10, 9.00, 9.80, 10.75, 11.50]
}

df = pd.DataFrame(data)
X = df[['Year']]
y = df['Price_Lakhs']

model = LinearRegression()
model.fit(X, y)

y_pred = model.predict(X)

print("=== CAR PRICE PREDICTION RESULT (2020 - 2026) ===")
print("Mean Squared Error:", round(mean_squared_error(y, y_pred), 4))
print("R2 Score:", round(r2_score(y, y_pred), 4))

sample_2027 = pd.DataFrame({'Year': [2027]})
pred_2027 = model.predict(sample_2027)[0]

print(f"Predicted Car Price for Year 2027: ₹{pred_2027:.2f} Lakhs")
print("SHARMILA S (192525011)\n")

plt.figure(figsize=(8, 5))
plt.scatter(df['Year'], df['Price_Lakhs'], color='navy', label='Actual Market Prices (2020-2026)', s=80)
plt.plot(df['Year'], y_pred, color='crimson', linestyle='-', linewidth=2, label='Linear Regression Trendline')

plt.title('Car Price Prediction Trend (2020 - 2026)', fontsize=12, fontweight='bold')
plt.xlabel('Model Year')
plt.ylabel('Price (₹ in Lakhs)')
plt.grid(True, linestyle='--', alpha=0.6)
plt.legend()
plt.tight_layout()
plt.show()
