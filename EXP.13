# Sharmila S
# Implement the Car Price Prediction Model using Python

import pandas as pd
import matplotlib.pyplot as plt
from sklearn.model_selection import train_test_split
from sklearn.linear_model import LinearRegression
from sklearn.metrics import mean_squared_error, r2_score

# Dataset
data = {
    'Year': [2015, 2016, 2017, 2018, 2019, 2020, 2021],
    'Price': [8000, 9500, 11000, 14000, 16500, 18000, 23000]
}

df = pd.DataFrame(data)
X = df[['Year']]
y = df['Price']

# Model Training on Full Data for Small Lab Dataset Stability
model = LinearRegression()
model.fit(X, y)

y_pred = model.predict(X)

# Text Output
print("=== CAR PRICE PREDICTION RESULT ===")
print("Mean Squared Error:", round(mean_squared_error(y, y_pred), 2))
print("R2 Score:", round(r2_score(y, y_pred), 4))

# Pass 2022 as a DataFrame to fix the feature name warning
sample_df = pd.DataFrame({'Year': [2022]})
pred_2022 = model.predict(sample_df)

print(f"Predicted Car Price for Year 2022: ${pred_2022[0]:.2f}")
print("SHARMILA S (192525011)\n")

# Visualization
plt.figure(figsize=(7, 5))
plt.scatter(df['Year'], df['Price'], color='blue', label='Actual Price Data', s=70)
plt.plot(df['Year'], model.predict(X), color='red', linestyle='-', linewidth=2, label='Regression Trendline')
plt.title('Car Price Prediction Over Time', fontsize=12, fontweight='bold')
plt.xlabel('Model Year')
plt.ylabel('Price ($)')
plt.grid(True, linestyle='--', alpha=0.6)
plt.legend()
plt.tight_layout()
plt.show()
