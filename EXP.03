import matplotlib.pyplot as plt
from sklearn.datasets import load_iris
from sklearn.tree import DecisionTreeClassifier, plot_tree
from sklearn.model_selection import train_test_split

iris = load_iris()
X_train, X_test, y_train, y_test = train_test_split(iris.data, iris.target, test_size=0.3, random_state=42)

clf = DecisionTreeClassifier(criterion='entropy', random_state=42).fit(X_train, y_train)

new_sample = [[5.1, 3.5, 1.4, 0.2]]
prediction = clf.predict(new_sample)

print("=== ID3 DECISION TREE ===")
print(f"Sample Features: {new_sample[0]}")
print(f"Predicted Class: {iris.target_names[prediction[0]]}")
print(f"Model Accuracy: {clf.score(X_test, y_test)*100:.2f}%")

plt.figure(figsize=(10, 6))
plot_tree(clf, feature_names=iris.feature_names, class_names=list(iris.target_names), filled=True, rounded=True)
plt.title("ID3 Decision Tree Structure", fontweight='bold')
plt.tight_layout()
plt.show()
